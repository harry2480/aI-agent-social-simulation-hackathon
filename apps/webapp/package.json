{
	"name": "webapp",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "prisma generate && next build",
		"build:vercel": "prisma migrate deploy && prisma generate && next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run --dir test/unit",
		"test:coverage": "vitest run --dir test/unit --coverage",
		"test:integration": "INTEGRATION_TEST=true vitest run --dir test/integration",
		"depcruise": "depcruise src --config .dependency-cruiser.cjs --output-type json | tsx scripts/check-dependency-graph.ts",
		"prisma": "prisma"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.33",
		"@prisma/adapter-pg": "7.9.1",
		"@prisma/client": "^7.9.1",
		"@xyflow/react": "^12.11.3",
		"ai": "^7.0.71",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2",
		"lucide-react": "^1.33.0",
		"next": "^16.3.1",
		"radix-ui": "^1.6.7",
		"react": "^19",
		"react-dom": "^19",
		"recharts": "^3.10.1",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.1.11",
		"dependency-cruiser": "^18.2.0",
		"dotenv": "^17.3.1",
		"prisma": "^7.9.1",
		"tailwindcss": "^4",
		"tsx": "^4",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
